{
  "app": "npx ts-node bin/infra.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk.*.json",
      "jest.config.js",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "*.tmp"
    ]
  },
  "context": {
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-rds:databaseInsensitiveClusterResourceId": true,
    "@aws-cdk/aws-rds:preventRenderingDeprecatedCredentials": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-events:eventsTargetQueueSameAccount": true,
    "@aws-cdk/iam:standardizedServicePrincipals": true,
    "@aws-cdk/aws-ecs:disableImageSigningRepeatedly": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateMapKeySuffix": true,
    "@aws-cdk/aws-s3:keepNotificationChainAccessControlMetadata": true,
    "@aws-cdk/aws-s3:transitionStateBeforeQueueDelete": true,
    "@aws-cdk/aws-kms:aliasNameRef": true,
    "@aws-cdk/aws-route53-patters:useCertificate": true,
    "@aws-cdk/custom-resources:installLatestAwsSdkDefault": false,
    "@aws-cdk/aws-rds:calibratedDelayOnRoute53Resolvers": true,
    "@aws-cdk/aws-appsync:useDataSourceCreatedWithResolverReturn": true,
    "@aws-cdk/aws-codepipeline:crossAccountKeyAliasStackSafeResourceName": true,
    "@aws-cdk/aws-s3:bypassFullPolicyChecksOnBucketDelete": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-iam:allowAllManagedPolicies": true,
    "@aws-cdk/aws-apigateway:authorizerChangeDeploymentTrigger": true,
    "@aws-cdk/aws-ec2:launchTemplateDefaultUserData": true,
    "@aws-cdk/aws-secretsmanager:useAttachedSecretResourcePolicyForLeftoverRequests": true,
    "@aws-cdk/aws-redshift:columnId": true,
    "@aws-cdk/aws-stepfunctions-tasks:evaluatorTemplatesPattern": true,
    "@aws-cdk/aws-iam:importedRoleStackSafeName": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true
  }
}
